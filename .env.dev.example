# CodeArena Platform - Development Configuration

## Application Profile
SPRING_PROFILES_ACTIVE=dev

## Server Configuration
SERVER_PORT=8080

## H2 Database (Development)
H2_PASSWORD=password

## MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/codearena

## Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

## JWT Configuration
JWT_SECRET=change-this-secret-key-in-production-min-32-chars-long-please
JWT_EXPIRATION=86400000

## Judge0 Configuration
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE0_TIMEOUT=30000
JUDGE0_POLL_INTERVAL=500

## Execution Configuration
EXECUTION_BACKEND=judge0
EXECUTION_FALLBACK_TO_LOCAL=true
EXECUTION_LOCAL_TIMEOUT_MS=30000
EXECUTION_LOCAL_MAX_OUTPUT_BYTES=200000
EXECUTION_LOCAL_JAVA_XMX_MB=256
