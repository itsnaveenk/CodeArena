# Environment variables for Docker deployment
# Copy this file to .env and fill in the values

# =======================
# Database Configuration
# =======================
DATABASE_NAME=codearena
DATABASE_USERNAME=codearena
DATABASE_PASSWORD=your_secure_postgres_password_here
DATABASE_PORT=5432
DATABASE_POOL_SIZE=20

# =======================
# MongoDB Configuration
# =======================
MONGO_USERNAME=admin
MONGO_PASSWORD=your_secure_mongo_password_here
MONGO_PORT=27017

# =======================
# Redis Configuration
# =======================
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_PORT=6379

# =======================
# JWT Configuration
# =======================
# Generate with: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_here_minimum_32_characters_long
JWT_EXPIRATION=86400000

# =======================
# Judge0 Configuration
# =======================
EXECUTION_BACKEND=judge0
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_judge0_api_key_here

# =======================
# Application Configuration
SPRING_PROFILES_ACTIVE=prod
# =======================
SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=8080
FRONTEND_PORT=80

# =======================
# Frontend Configuration
# =======================
# Set to your backend URL (for production deployments)
VITE_API_BASE_URL=http://localhost:8080
