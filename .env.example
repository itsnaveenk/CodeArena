# =============================================================================
# CodeArena Platform - Environment Variables
# =============================================================================
# Copy this file to .env and customize the values
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Options: dev, prod, docker
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Development: H2 Database (default - no setup required)
H2_PASSWORD=password

# Production: PostgreSQL (uncomment and configure for production)
# DATABASE_URL=jdbc:postgresql://localhost:5432/codearena
# DATABASE_USERNAME=codearena
# DATABASE_PASSWORD=your-secure-database-password
# DATABASE_POOL_SIZE=20
# DATABASE_POOL_MIN_IDLE=5

# MongoDB connection URI
MONGODB_URI=mongodb://localhost:27017/codearena

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# Secret key for signing JWT tokens (minimum 32 characters)
# IMPORTANT: Change this in production!
JWT_SECRET=change-this-secret-key-in-production-min-32-chars

# Token expiration time in milliseconds (default: 24 hours)
JWT_EXPIRATION=86400000

# -----------------------------------------------------------------------------
# Judge0 Configuration
# -----------------------------------------------------------------------------
# Judge0 API endpoint
JUDGE0_API_URL=http://localhost:2358

# Judge0 API key (leave empty for local Judge0 without auth)
JUDGE0_API_KEY=

# -----------------------------------------------------------------------------
# Execution Backend
# -----------------------------------------------------------------------------
# Options: "judge0" or "local"
EXECUTION_BACKEND=judge0

# Fallback to local execution if Judge0 fails
EXECUTION_FALLBACK_TO_LOCAL=true

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
SERVER_PORT=8080

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Redis connection settings for caching and async execution
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Spring Profiles
# -----------------------------------------------------------------------------
# Options: dev, prod, docker
SPRING_PROFILES_ACTIVE=dev
